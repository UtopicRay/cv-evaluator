// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@map("sessions")
}
 
model User {
  id            String    @id @default(cuid())
  name          String
  lastName      String   @map("last_name")
  email         String?   @unique
  password      String
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  image         String?
  accounts      Account[]
  sessions      Session[]
  cvs           CV[]
 
  @@map("users")
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CV {
  id              String   @id @default(cuid())
  userId          String
  
  // Información del archivo
  fileName        String
  originalName    String
  fileSize        Int      // En bytes
  fileUrl         String   // URL en storage (S3, Supabase, etc)
  mimeType        String   // "application/pdf", "application/docx"
  
  // Contenido extraído
  rawText         String   @db.Text // Texto completo extraído del PDF
  
  // Score principal
  overallScore    Float?   // 0-100
  scoreGrade      String?  // "A", "B", "C", "D", "F"
  
  // Estado
  status          CVStatus @default(PENDING)
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  analyzedAt      DateTime?
  
  // Relaciones
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses        CVAnalysis[]
  sections        CVSection[]
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum CVStatus {
  PENDING       // Subido, esperando análisis
  PROCESSING    // En proceso de análisis
  COMPLETED     // Análisis completado
  ERROR         // Error en el análisis
}

// ============================================
// ANÁLISIS DETALLADO DEL CV
// ============================================

model CVAnalysis {
  id              String   @id @default(cuid())
  cvId            String
  
  // Análisis por secciones
  experienceScore Float?   // 0-100
  educationScore  Float?   // 0-100
  skillsScore     Float?   // 0-100
  formatScore     Float?   // 0-100
  keywordsScore   Float?   // 0-100
  
  // Feedback detallado
  strengths       Json     // Array de strings: ["Experiencia sólida en...", "Buena estructura..."]
  weaknesses      Json     // Array de strings: ["Falta información de contacto", ...]
  suggestions     Json     // Array de strings: ["Agregar certificaciones", ...]
  
  // Keywords detectadas
  detectedSkills  Json     // Array: ["JavaScript", "React", "Node.js"]
  missingKeywords Json     // Keywords que deberían estar
  
  // ATS (Applicant Tracking System) Score
  atsScore        Float?   // Qué tan bien pasa filtros automáticos
  
  // Metadata del análisis
  aiModel         String   // "gpt-4", "gpt-3.5-turbo"
  tokensUsed      Int?     // Para tracking de costos
  analysisTime    Int?     // Tiempo en segundos
  
  createdAt       DateTime @default(now())
  
  // Relación
  cv              CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  
  @@index([cvId])
}

// ============================================
// SECCIONES DEL CV (Parseadas)
// ============================================

model CVSection {
  id          String      @id @default(cuid())
  cvId        String
  
  type        SectionType
  title       String?     // "Work Experience", "Education", etc.
  content     String      @db.Text
  order       Int         // Orden en el CV
  
  // Metadata específica por tipo
  metadata    Json?       // Flexible para cada tipo de sección
  
  createdAt   DateTime    @default(now())
  
  cv          CV          @relation(fields: [cvId], references: [id], onDelete: Cascade)
  
  @@index([cvId])
  @@index([type])
}

enum SectionType {
  CONTACT
  SUMMARY
  EXPERIENCE
  EDUCATION
  SKILLS
  CERTIFICATIONS
  LANGUAGES
  PROJECTS
  OTHER
}
